{
  "manifest_version": 3,
  "name": "LeetGlint",
  "version": "1.0.0",
  "description": "One-nudge clarifications and context-aware debugging hints for LeetCode.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://leetcode.com/*",
    "https://api.anthropic.com/*",
    "https://api.openai.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "src/background/index.ts"
  },
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/problems/*"],
      "js": ["src/content/index.tsx"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "LeetGlint",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "matches": ["https://leetcode.com/*"],
      "resources": ["vendor/katex/katex.min.css", "vendor/katex/fonts/*"]
    }
  ]
}
